{
  "name": "@fleetwood/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main/index.cjs --external:electron",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "build:hooks": "mkdir -p dist/hooks && cp ../hooks/*.sh dist/hooks/",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer && pnpm build:hooks",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "install-app": "pnpm bundle && rm -rf /Applications/Fleetwood.app && cp -R release/Fleetwood.app /Applications/ && echo \"installed /Applications/Fleetwood.app\"",
    "bundle": "pnpm build && pnpm icon && node scripts/make-app.mjs"
  },
  "dependencies": {
    "@fleetwood/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "description": "tmux-native cockpit for coordinating coding agents"
}
