{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is always bundled (esbuild for main/preload, Vite for the
    // renderer), so bundler resolution is the honest description of how imports
    // actually get resolved here — unlike core/cli, which Node runs directly.
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
